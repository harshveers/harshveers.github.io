---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/400-italic.css';
import '@fontsource/source-serif-4/500.css';
import '@fontsource/source-serif-4/600.css';
import '../styles/global.css';
import { contactLinks, rssLink, site, SITE_URL, xHandle } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  /** Path of the Open Graph image, e.g. /og/default.png. */
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  current?: 'writing';
  jsonLd?: object;
  /** Font files to preload, e.g. the resume typeface on the home page. */
  preloadFonts?: string[];
  noindex?: boolean;
}

const { title, description = site.tagline, ogImage = '/og/default.png', ogType = 'website', current, jsonLd, noindex, preloadFonts = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const image = new URL(ogImage, SITE_URL).href;
const year = new Date().getUTCFullYear();
const footerLinks = [...contactLinks, rssLink];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      // Apply a saved theme before first paint. Light is the default; the system setting is ignored.
      try {
        if (localStorage.getItem('theme') === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch {}
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <link rel="alternate" type="application/rss+xml" title={`${site.headline}: writing & appearances`} href={new URL('/rss.xml', SITE_URL).href} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.headline} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    {xHandle && <meta name="twitter:site" content={`@${xHandle}`} />}
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={image} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="column site-header">
      <a class="home" href="/">{site.headline}</a>
      <div class="actions">
        <nav aria-label="Primary">
          <a class="pill" href="/writing/" aria-label="Writing &amp; appearances" aria-current={current === 'writing' ? 'page' : undefined}>
            Writing<span class="pill-rest"> &amp; appearances</span>
          </a>
        </nav>
        <button class="theme-toggle" type="button" aria-label="Dark theme" aria-pressed="false" hidden>
          <svg class="moon" aria-hidden="true" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16.5 12.2A7 7 0 0 1 7.8 3.5a7 7 0 1 0 8.7 8.7z" />
          </svg>
          <svg class="sun" aria-hidden="true" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
            <circle cx="10" cy="10" r="3.5" />
            <path d="M10 1.5v2M10 16.5v2M1.5 10h2M16.5 10h2M4 4l1.4 1.4M14.6 14.6L16 16M4 16l1.4-1.4M14.6 5.4L16 4" />
          </svg>
        </button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="column inner">
        <span>© {year} {site.headline}</span>
        <nav aria-label="Contact and feeds">
          {footerLinks.map((l) => <a href={l.href} rel={l.external ? 'noopener me' : undefined}>{l.label}</a>)}
        </nav>
      </div>
    </footer>
    <script is:inline>
      // The theme toggle: the site's only script. Without JS the button stays hidden and the site is light.
      (() => {
        const root = document.documentElement;
        const button = document.querySelector('.theme-toggle');
        const meta = document.querySelector('meta[name="theme-color"]');
        const sync = () => {
          const dark = root.dataset.theme === 'dark';
          button.setAttribute('aria-pressed', String(dark));
          meta.content = dark ? '#121315' : '#ffffff';
        };
        button.addEventListener('click', () => {
          const dark = root.dataset.theme !== 'dark';
          if (dark) root.dataset.theme = 'dark';
          else delete root.dataset.theme;
          try {
            localStorage.setItem('theme', dark ? 'dark' : 'light');
          } catch {}
          sync();
        });
        sync();
        button.hidden = false;
      })();
    </script>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding-top: 40px;
  }

  .home {
    display: inline-flex;
    align-items: center;
    padding: 6px 0;
    color: var(--ink);
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  nav[aria-label='Primary'] {
    font-size: 15px;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: none;
    color: var(--ink-2);
    cursor: pointer;
    transition:
      border-color 0.18s ease,
      color 0.18s ease;
  }

  .theme-toggle[hidden] {
    display: none;
  }

  .theme-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* Shows the theme you would switch to. */
  .theme-toggle .sun,
  :global([data-theme='dark']) .theme-toggle .moon {
    display: none;
  }

  :global([data-theme='dark']) .theme-toggle .sun {
    display: block;
  }

  .pill {
    display: inline-block;
    white-space: nowrap;
    padding: 8px 14px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    color: var(--ink-2);
    text-decoration: none;
    transition:
      border-color 0.18s ease,
      color 0.18s ease;
  }

  .pill:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .pill[aria-current='page'] {
    background: var(--accent-soft);
    border-color: transparent;
    color: var(--accent);
    font-weight: 500;
  }

  .site-footer {
    margin-top: 120px;
    background: var(--surface);
    border-top: 1px solid var(--rule);
  }

  .site-footer .inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: 36px;
    padding-bottom: 48px;
    font-size: 14px;
    color: var(--ink-3);
  }

  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  .site-footer nav a {
    padding: 6px 0;
    color: var(--ink-2);
    text-decoration: none;
  }

  .site-footer nav a:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .site-header {
      padding-top: 18px;
    }
    .home {
      font-size: 14px;
    }
    nav[aria-label='Primary'] {
      font-size: 14px;
    }
    .theme-toggle {
      width: 44px;
      height: 44px;
    }
  }

  /* Too narrow for the full label next to the name: the pill reads "Writing" (its aria-label stays complete). */
  @media (max-width: 420px) {
    .pill-rest {
      display: none;
    }
    .home {
      min-height: 44px;
    }
    .pill {
      position: relative;
      padding: 9px 14px;
    }
    /* Keeps the designed 40px pill while giving it a 44px tap target. */
    .pill::before {
      content: '';
      position: absolute;
      inset: -2px;
    }
    .site-footer {
      margin-top: 72px;
    }
    .site-footer .inner {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 14px;
      padding-top: 28px;
      padding-bottom: 40px;
    }
    .site-footer nav a {
      padding: 8px 0;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
    }
  }
</style>

---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getItems, isNative, isoDate, longDate, readingMinutes, type Item } from '../../lib/items';
import { resume } from '../../lib/resume';
import { SITE_URL } from '../../lib/site';

export async function getStaticPaths() {
  const items = await getItems();
  return items.filter(isNative).map((item) => ({
    params: { slug: item.id },
    props: { item, more: items.filter((i) => i.id !== item.id).slice(0, 3) },
  }));
}

interface Props {
  item: Item;
  more: Item[];
}

const { item, more } = Astro.props;
const { Content } = await render(item);
const minutes = readingMinutes(item.body ?? '');

const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: item.data.title,
  datePublished: isoDate(item.data.date),
  description: item.data.excerpt,
  author: { '@type': 'Person', name: resume.basics.name, url: `${SITE_URL}/` },
  image: `${SITE_URL}/og/${item.id}.png`,
  mainEntityOfPage: `${SITE_URL}/writing/${item.id}/`,
};
---

<Base title={item.data.title} description={item.data.excerpt} ogImage={`/og/${item.id}.png`} ogType="article" jsonLd={article}>
  <article class="narrow article">
    <header>
      <h1 class="serif">{item.data.title}</h1>
      <p class="meta">
        <time datetime={isoDate(item.data.date)}>{longDate(item.data.date)}</time> · {minutes} min read
      </p>
    </header>
    <div class="prose serif">
      <Content />
    </div>
  </article>

  <nav class="narrow more" aria-labelledby="more-h">
    <a class="back" href="/writing/">← All writing</a>
    <h2 id="more-h" class="sr-only">More writing</h2>
    <PostList items={more} />
  </nav>
</Base>

<style>
  /* Article column: 680px, with the related rows aligned to it. */
  .narrow {
    max-width: calc(680px + 2 * var(--gutter));
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .article {
    padding-top: 96px;
  }

  h1 {
    margin: 0;
    font-size: 38px;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .meta {
    margin: 12px 0 40px;
    font-size: 14px;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .prose {
    max-width: 68ch;
    font-size: 19px;
    line-height: 1.7;
    overflow-wrap: break-word;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(pre),
  .prose :global(img) {
    margin: 0 0 1.1em;
  }

  .prose :global(h2) {
    margin: 1.8em 0 0.6em;
    font-size: 26px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .prose :global(h3) {
    margin: 1.6em 0 0.5em;
    font-size: 21px;
    font-weight: 500;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.82em;
    padding: 0.1em 0.35em;
    background: var(--surface);
    border-radius: var(--radius-sm);
  }

  .prose :global(pre) {
    padding: 18px 20px;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow-x: auto;
    line-height: 1.55;
  }

  .prose :global(pre code) {
    padding: 0;
    font-size: 14px;
    background: none;
  }

  .prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  .more {
    padding-top: 72px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-bottom: 8px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .article {
      padding-top: 48px;
    }
    h1 {
      font-size: 30px;
    }
    .meta {
      font-size: 13px;
      margin-bottom: 28px;
    }
    .prose {
      font-size: 18px;
    }
    .prose :global(h2) {
      font-size: 23px;
    }
    .prose :global(pre) {
      padding: 16px;
    }
    .more {
      padding-top: 56px;
    }
  }
</style>

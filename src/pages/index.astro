---
import { getImage, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import RichText from '../components/RichText.astro';
import { headshot } from '../lib/headshot';
import { companyYears, currentCompany, currentRole, resume, roleDates } from '../lib/resume';
import { contactLinks, profileUrls, rssLink, site, SITE_URL } from '../lib/site';

const subtitle = `${currentRole.title}, ${currentCompany.company} · ${resume.basics.city}, ${site.country}`;
const download = headshot && (await getImage({ src: headshot, format: 'jpg', width: headshot.width }));
const elsewhere = [...contactLinks, rssLink];

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: resume.basics.name,
  url: `${SITE_URL}/`,
  image: download ? new URL(download.src, SITE_URL).href : undefined,
  jobTitle: currentRole.title,
  worksFor: { '@type': 'Organization', name: currentCompany.company },
  alumniOf: resume.education.map((e) => ({ '@type': 'CollegeOrUniversity', name: e.institution })),
  sameAs: profileUrls,
};

// "B.Tech. in -" plus its highlights reads as "B.Tech., Engineering Physics (Major), …".
const degreeLine = (e: (typeof resume.education)[number]) =>
  [e.degree?.replace(/\s+in\s+-\s*$/, ''), ...e.highlights.map((h) => h.map((s) => s.text).join(''))]
    .filter(Boolean)
    .join(', ')
    .replace(/(\S)\(/g, '$1 (');
const years = (e: (typeof resume.education)[number]) => (e.end ? `${e.start} – ${e.end}` : e.start);
---

<Base
  title={site.headline}
  ogType="profile"
  jsonLd={person}
  preloadFonts={['/fonts/latin-modern/lmr-web-regular.woff2', '/fonts/latin-modern/lmr-web-bold.woff2']}
>
  <div class="column resume-type">
    <section aria-labelledby="about-h" class="intro">
      <div class="heading">
        {
          headshot && (
            <Picture
              src={headshot}
              formats={['avif', 'webp']}
              widths={[104, 208, 312]}
              sizes="(max-width: 640px) 72px, 104px"
              alt={`Portrait of ${resume.basics.name}`}
              class="portrait"
              loading="eager"
            />
          )
        }
        <div>
          <h1 id="about-h" class="sr-only">{resume.basics.name}</h1>
          <p class="role serif">{subtitle}</p>
          {site.profile_headline && <p class="profile-headline">{site.profile_headline}</p>}
        </div>
      </div>
      <div class="letter serif">
        {
          resume.introduction.map((p) => (
            <p>
              <RichText text={p} />
            </p>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="exp-h">
      <h2 id="exp-h" class="section-title">Experience</h2>
      <ol class="timeline">
        {
          resume.experience.map((company) => {
            const current = company.roles.some((r) => r.end === null);
            return (
              <li class:list={{ current }}>
                <span class="years">{companyYears(company)}</span>
                <span class="rail" aria-hidden="true">
                  <span class="dot" />
                </span>
                <div class="body">
                  <h3 class="company serif">{company.company}</h3>
                  <ul class="roles">
                    {company.roles.map((role) => (
                      <li>
                        <div class="role-head">
                          <span>{role.title}</span>
                          <span class="role-dates">{roleDates(role)}</span>
                        </div>
                        {role.summary.map((p) => (
                          <p class="summary">
                            <RichText text={p} />
                          </p>
                        ))}
                        {role.highlights.length > 0 && (
                          <ul class="highlights">
                            {role.highlights.map((h) => (
                              <li>
                                <RichText text={h} />
                              </li>
                            ))}
                          </ul>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            );
          })
        }
      </ol>
    </section>

    <section aria-labelledby="areas-h">
      <h2 id="areas-h" class="section-title">What I work on</h2>
      <dl class="areas">
        {
          site.focus_areas.map((a) => (
            <div>
              <dt>{a.title}</dt>
              <dd>{a.line}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section aria-labelledby="skills-h">
      <h2 id="skills-h" class="section-title">Expertise</h2>
      <dl class="skills">
        {
          resume.skills.map((s) => (
            <div>
              <dt>{s.label}</dt>
              <dd>{s.items.join(' · ')}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section aria-labelledby="edu-h">
      <h2 id="edu-h" class="section-title">Education</h2>
      {
        resume.education.map((e) => (
          <div class="edu">
            <span class="tile" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
                <path d="M10 3L2 7l8 4 8-4-8-4z" />
                <path d="M5 9v4c0 1.5 2.2 3 5 3s5-1.5 5-3V9" />
              </svg>
            </span>
            <div>
              <p class="institution serif">{e.institution}</p>
              <p class="degree">
                {degreeLine(e)} · {years(e)}
              </p>
            </div>
          </div>
        ))
      }
    </section>

    {
      site.bio && (
        <section aria-labelledby="bio-h">
          <h2 id="bio-h" class="section-title">Short bio</h2>
          <p class="hint">For events and introductions.</p>
          <div class="bio">
            <p class="serif">{site.bio}</p>
            {download && (
              <a class="download" href={download.src} download="harshveer-singh-headshot.jpg">
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M7 2v7M4 6.5L7 9.5l3-3M2.5 12h9" />
                </svg>
                Download headshot
              </a>
            )}
          </div>
        </section>
      )
    }

    <section aria-labelledby="else-h">
      <h2 id="else-h" class="section-title">Elsewhere</h2>
      <ul class="chips">
        {
          elsewhere.map((l) => (
            <li>
              <a href={l.href} rel={l.external ? 'noopener me' : undefined}>
                {l.label}
                {l.external && ' ↗'}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  /* The whole About content is set in the resume's typeface, Latin Modern Roman. */
  .resume-type {
    --font-serif: var(--font-resume);
    --font-sans: var(--font-resume);
    font-family: var(--font-resume);
  }

  /* Latin Modern has only regular and bold; headings are bold, as in the resume. */
  .resume-type :is(h2, h3, dt, .role-head, .institution) {
    font-weight: 700;
  }

  section {
    padding-top: 80px;
  }

  .intro {
    padding-top: 96px;
  }

  .heading {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 36px;
  }

  .role {
    margin: 0;
    font-size: 26px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  :global(.portrait) {
    flex: 0 0 104px;
    width: 104px;
    height: 104px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--accent-soft);
    box-shadow:
      0 0 0 4px var(--bg),
      0 0 0 5px var(--rule);
  }

  .profile-headline {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .letter {
    display: flex;
    flex-direction: column;
    gap: 20px;
    font-size: 19px;
    line-height: 1.7;
  }

  .letter p {
    margin: 0;
  }

  /* Heading-to-content spacing differs per section in the design. */
  .section-title {
    margin-bottom: 20px;
  }

  #exp-h {
    margin-bottom: 28px;
  }

  #edu-h,
  #else-h {
    margin-bottom: 16px;
  }

  #bio-h {
    margin-bottom: 6px;
  }

  /* Experience: dates | rail | company. */

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline > li {
    display: grid;
    grid-template-columns: 112px 24px minmax(0, 1fr);
    column-gap: 16px;
    padding-bottom: 36px;
  }

  .timeline > li:last-child {
    padding-bottom: 0;
  }

  .years {
    padding-top: 3px;
    font-size: 14px;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .rail {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .timeline > li:not(:last-child) .rail::before {
    content: '';
    position: absolute;
    top: 14px;
    bottom: -36px;
    width: 1px;
    background: var(--rule);
  }

  .dot {
    position: relative;
    margin-top: 8px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 1.5px solid var(--ink-3);
  }

  .current .dot {
    margin-top: 7px;
    width: 11px;
    height: 11px;
    background: var(--accent);
    border: 0;
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .company {
    margin: 0 0 10px;
    font-size: 21px;
    font-weight: 500;
    line-height: 1.3;
  }

  .roles {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 16px;
  }

  /* Each role: title and dates, then its summary paragraphs and highlights from the resume. */
  .roles > li + li {
    margin-top: 20px;
  }

  .role-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-weight: 500;
  }

  .summary {
    margin: 8px 0 0;
    font-size: 15px;
    color: var(--ink-2);
  }

  .role-dates {
    flex: none;
    font-size: 14px;
    color: var(--ink-3);
  }

  .highlights {
    margin: 8px 0 0;
    padding: 0 0 0 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 15px;
    color: var(--ink-2);
  }

  /* What I work on: 2×2 outlined cards. */
  .areas {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    font-size: 15px;
  }

  .areas > div {
    padding: 20px 22px;
    border: 1px solid var(--rule);
    border-radius: 14px;
  }

  .areas dt,
  .skills dt {
    font-weight: 600;
    margin-bottom: 4px;
  }

  .areas dd,
  .skills dd {
    margin: 0;
    color: var(--ink-2);
  }

  .skills {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 15px;
  }

  .skills > div {
    padding-bottom: 16px;
    border-bottom: 1px solid var(--rule);
  }

  .skills > div:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .edu {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .tile {
    flex: 0 0 44px;
    height: 44px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--rule);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-2);
  }

  .institution {
    margin: 0;
    font-size: 19px;
    font-weight: 500;
  }

  .degree {
    margin: 0;
    font-size: 15px;
    color: var(--ink-2);
  }

  .hint {
    margin: 0 0 16px;
    font-size: 15px;
    color: var(--ink-3);
  }

  .bio {
    padding: 26px 28px;
    background: var(--accent-soft);
    border-radius: var(--radius-lg);
  }

  .bio p {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
  }

  .download {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    padding: 8px 14px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    background: var(--bg);
    border-radius: var(--radius-pill);
  }

  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 15px;
  }

  .chips a {
    display: inline-flex;
    align-items: center;
    padding: 9px 16px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 0.18s ease,
      color 0.18s ease;
  }

  .chips a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (max-width: 640px) {
    section {
      padding-top: 56px;
    }
    .intro {
      padding-top: 48px;
    }
    .heading {
      gap: 16px;
      margin-bottom: 24px;
    }
    .role {
      font-size: 20px;
    }
    :global(.portrait) {
      flex-basis: 72px;
      width: 72px;
      height: 72px;
      box-shadow:
        0 0 0 3px var(--bg),
        0 0 0 4px var(--rule);
    }
    .profile-headline {
      margin-top: 6px;
      font-size: 14px;
    }
    .letter {
      gap: 18px;
      font-size: 18px;
      line-height: 1.65;
    }
    .section-title {
      margin-bottom: 16px;
    }
    #exp-h {
      margin-bottom: 20px;
    }
    #edu-h,
    #else-h {
      margin-bottom: 14px;
    }
    #bio-h {
      margin-bottom: 4px;
    }
    /* Mobile timeline: rail | body, with the dates above the company. */
    .timeline > li {
      grid-template-columns: 16px minmax(0, 1fr);
      grid-template-areas: 'rail years' 'rail body';
      column-gap: 14px;
      padding-bottom: 28px;
    }
    .years {
      grid-area: years;
      padding-top: 0;
      font-size: 13px;
    }
    .rail {
      grid-area: rail;
    }
    .body {
      grid-area: body;
    }
    .timeline > li:not(:last-child) .rail::before {
      bottom: -28px;
    }
    .dot {
      margin-top: 7px;
    }
    .current .dot {
      margin-top: 6px;
      width: 10px;
      height: 10px;
    }
    .company {
      margin-bottom: 8px;
      font-size: 20px;
    }
    .roles {
      font-size: 15px;
    }
    .role-head {
      flex-direction: column;
      gap: 0;
    }
    .summary {
      font-size: 14px;
    }
    .role-dates {
      font-size: 13px;
    }
    .highlights {
      padding-left: 18px;
      font-size: 14px;
    }
    .areas {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }
    .areas > div {
      padding: 16px 18px;
      border-radius: var(--radius);
    }
    .tile {
      flex-basis: 40px;
      height: 40px;
      border-radius: 10px;
    }
    .institution {
      font-size: 18px;
    }
    .degree {
      font-size: 14px;
    }
    .hint {
      margin: 0 0 14px;
      font-size: 14px;
    }
    .bio {
      padding: 20px;
      border-radius: 14px;
    }
    .bio p {
      font-size: 17px;
    }
    .download {
      min-height: 44px;
      padding: 0 16px;
    }
    .chips {
      gap: 8px;
    }
    .chips a {
      min-height: 44px;
      padding: 0 16px;
    }
  }
</style>

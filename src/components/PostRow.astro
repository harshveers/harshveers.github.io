---
import { isArchive, isNative, itemHref, pillLabel, shortDate, isoDate, type Item } from '../lib/items';

interface Props {
  item: Item;
}

const { item } = Astro.props;
const native = isNative(item);
const archive = isArchive(item);
---

<li>
  <a class:list={['post', { archive, external: !native }]} href={itemHref(item)} rel={native ? undefined : 'noopener'}>
    <time class="date" datetime={isoDate(item.data.date)}>{shortDate(item.data.date)}</time>
    <span class="title serif">{item.data.title}</span>
    {!archive && <span class="excerpt">{item.data.excerpt}</span>}
    <span class="kind">{pillLabel(item)}{!native && <span class="sr-only"> (external link)</span>}</span>
    <span class="go" aria-hidden="true">
      {
        native ? (
          <svg width="14" height="14" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M2.5 6h7M6.5 3l3 3-3 3" />
          </svg>
        ) : (
          <svg width="14" height="14" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M3.5 8.5l5-5M4.5 3.5h4v4" />
          </svg>
        )
      }
    </span>
  </a>
</li>

<style>
  /* Desktop: date | title, excerpt, pill | icon. The whole row is the link. */
  .post {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr) 20px;
    grid-template-areas:
      'date title go'
      '.    excerpt .'
      '.    kind  .';
    column-gap: 20px;
    align-items: baseline;
    padding: 18px 16px;
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
    transition: background-color 0.18s ease;
  }

  .post:hover {
    background: var(--surface);
    color: inherit;
  }

  .date {
    grid-area: date;
    font-size: 14px;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .title {
    grid-area: title;
    font-size: 21px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.005em;
    transition: color 0.18s ease;
  }

  .archive .title {
    font-size: 18px;
  }

  .post:hover .title {
    color: var(--accent);
  }

  .excerpt {
    grid-area: excerpt;
    margin-top: 6px;
    font-size: 16px;
    color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .kind {
    grid-area: kind;
    justify-self: start;
    margin-top: 10px;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.6;
    color: var(--ink-2);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
  }

  .go {
    grid-area: go;
    display: flex;
    align-self: start;
    padding-top: 8px;
    color: var(--ink-3);
    transition:
      transform 0.18s ease,
      color 0.18s ease;
  }

  .post:hover .go {
    transform: translate(2px, -2px);
    color: var(--accent);
  }

  /* Mobile: date and pill on top, then title, then excerpt; rows divided by a rule. */
  @media (max-width: 640px) {
    li {
      border-bottom: 1px solid var(--rule);
    }
    .post {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'date kind'
        'title title'
        'excerpt excerpt';
      align-items: center;
      row-gap: 6px;
      padding: 18px 0;
      border-radius: 0;
    }
    .post:hover {
      background: none;
    }
    .post:active {
      background: var(--surface);
    }
    .date {
      font-size: 13px;
    }
    .title {
      font-size: 19px;
    }
    .archive .title {
      font-size: 17px;
    }
    .excerpt {
      margin-top: 0;
      font-size: 15px;
    }
    .kind {
      justify-self: end;
      margin-top: 0;
      padding: 1px 9px;
    }
    .external .kind::after {
      content: ' ↗';
    }
    .go {
      display: none;
    }
  }
</style>

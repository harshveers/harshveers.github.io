---
import type { RichText } from '../lib/resume';

interface Props {
  text: RichText;
}

const { text } = Astro.props;
---

{
  text.map((s) => {
    const inner = s.bold ? <strong>{s.text}</strong> : s.text;
    if (!s.href) return inner;
    // Outside links open in a new tab; mailto: and on-site links don't.
    return /^https?:/.test(s.href) ? (
      <a href={s.href} target="_blank" rel="noopener">
        {inner}
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
    ) : (
      <a href={s.href}>{inner}</a>
    );
  })
}
